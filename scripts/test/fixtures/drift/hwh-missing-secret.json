{
  "family": "hwh-missing-secret",
  "containerDefinitions": [
    {
      "name": "missing-secret",
      "command": ["scrape", "spotify"],
      "environment": [
        { "name": "HTTP_ADDR", "value": ":8080" },
        { "name": "LOG_LEVEL", "value": "info" },
        { "name": "EMAIL_SENDER", "value": "ses" },
        { "name": "APP_BASE_URL", "value": "https://example.test" }
      ],
      "secrets": [
        { "name": "DB_USER", "valueFrom": "arn:aws:secretsmanager:us-east-1:111111111111:secret:rds!db-aaaa:username::" }
      ]
    }
  ],
  "revision": 42
}
